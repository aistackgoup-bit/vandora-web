# Copy to .env.local for local development and set the same values in Vercel.
# Anything prefixed with VITE_ is bundled into the browser: never put secrets there.

# ---------- Public (browser) ----------
# Supabase project (Settings > API). The anon key is public by design; RLS protects the data.
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Public base URL of the R2 bucket (custom domain or r2.dev), no trailing slash
VITE_CLOUDFLARE_PUBLIC_URL="https://media.vandora.boutique"

# Klaviyo public site key
VITE_KLAVIYO_PUBLIC_KEY="YOUR_KLAVIYO_PUBLIC_KEY"

# Affiliate system (Raider)
VITE_RAIDER_URL="https://afiliados.vandora.boutique"
VITE_RAIDER_TRACK_TOKEN="YOUR_RAIDER_TRACK_TOKEN"

# ---------- Server only (Vercel functions in /api) ----------
# Used by /api/sitemap and /api/storage. Never expose with a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Cloudflare R2 (R2 > Manage API tokens). Used by /api/storage to sign uploads.
R2_ACCOUNT_ID="YOUR_CLOUDFLARE_ACCOUNT_ID"
R2_ACCESS_KEY_ID="YOUR_R2_ACCESS_KEY_ID"
R2_SECRET_ACCESS_KEY="YOUR_R2_SECRET_ACCESS_KEY"
R2_BUCKET_NAME="YOUR_R2_BUCKET_NAME"
R2_PUBLIC_URL="https://media.vandora.boutique"

# Optional: overrides the Klaviyo private key saved in Admin > Ajustes
KLAVIYO_PRIVATE_API_KEY=""
