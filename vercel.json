{
    "functions": {
        "api/kie-image.js": { "maxDuration": 60 },
        "api/kie-callback.js": { "maxDuration": 60 }
    },
    "rewrites": [
        {
            "source": "/sitemap.xml",
            "destination": "/api/sitemap"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}
